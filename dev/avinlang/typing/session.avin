module dev.avinlang.typing

import dev.avinlang.tui.{Alt, Backspace, Char, Ctrl, Enter, Escape, Event, KeyPress, Stop, Tab}

// Times are monotonic milliseconds, supplied by the caller so scoring is deterministic in tests.
class Session(val passage: string)
    val target: Vector[char] = passage.chars()
    val typed = Buffer[char]()
    var started: Option[long] = None
    var finished: Option[long] = None
    var attempts = 0
    var mistakes = 0

    done() -> bool = typed.length() == target.length()

    typeChar(c: char, now: long)
        if done() || c < ' ' || c == char(127) then return
        if started.isEmpty() then started = Some(now)
        attempts += 1
        if c != target(typed.length()) then mistakes += 1
        typed.addOne(c)
        if done() then finished = Some(now)

    backspace()
        if !done() && typed.nonEmpty() then typed.remove(typed.length() - 1)

    elapsed(now: long) -> long = started match
        Some(start) -> maxMillis(0, finished.getOrElse(now) - start)
        None -> 0

    correct() -> int
        var count = 0
        for i in 0 ..< typed.length()
            if typed(i) == target(i) then count += 1
        count

    // Five correct characters make one standard word; mistakes still cost elapsed time.
    wpm(now: long) -> int
        val ms = elapsed(now)
        if ms <= 0 then return 0
        int(real(correct()) * 12000.0 / real(ms))

    accuracy() -> int = if attempts == 0 then 100 else int(real(attempts - mistakes) * 100.0 / real(attempts))

    // 0 keeps practicing, 1 quits, 2 retries, 3 chooses the next passage.
    handle(event: Event, now: long) -> int = event match
        Stop(_) -> 1
        KeyPress(Escape, _) -> 1
        KeyPress(Char('c'), mods) if (mods & Ctrl) != 0 -> 1
        KeyPress(Char('r'), mods) if (mods & Ctrl) != 0 -> 2
        KeyPress(Tab, _) -> 3
        KeyPress(Enter, _) if done() -> 3
        KeyPress(Backspace, _) ->
            backspace()
            0
        KeyPress(Char(c), mods) if (mods & (Ctrl | Alt)) == 0 ->
            typeChar(c, now)
            0
        _ -> 0

private maxMillis(a: long, b: long) -> long = if a > b then a else b
