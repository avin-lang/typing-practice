module tests

import avin.random.Random
import dev.avinlang.tui.Grid
import dev.avinlang.typing.{Practice, choosePassage, drawPractice, longLiterature, longPassages, passages, shortLiterature}

@test("the passage collection contains varied, distinct printable drills")
collection()
    assert(passages.length >= 24)
    for i in 0 ..< passages.length
        assert(passages(i).charCount > 80)
        for c in passages(i).chars
            assert(' ' <= c <= '~')
        for j in i + 1 ..< passages.length
            assert(passages(i) != passages(j))

@test("random selection reaches every passage and never immediately repeats")
selection()
    val rng = Random(42)
    val seen = Buffer[int]()
    var previous: Option[int] = None
    for _ in 0 ..< 1000
        val chosen = choosePassage(rng, previous)
        assert(0 <= chosen < passages.length)
        previous match
            Some(index) -> assert(chosen != index)
            None -> ()
        if !seen.contains(chosen) then seen.addOne(chosen)
        previous = Some(chosen)
    assertEq(seen.length, passages.length)

@test("initial selection varies and the same seed reproduces choices")
initialSelection()
    val a = Random(123)
    val b = Random(123)
    val seen = Buffer[int]()
    for _ in 0 ..< 200
        val chosen = choosePassage(a, None)
        assertEq(chosen, choosePassage(b, None))
        if !seen.contains(chosen) then seen.addOne(chosen)
    assert(seen.length > 4)

@test("every short excerpt carries an author, work, and source shown during practice")
literaryAttribution()
    assertEq(shortLiterature.length, passages.length)
    for i in 0 ..< shortLiterature.length
        val excerpt = shortLiterature(i)
        assertEq(excerpt.text, passages(i))
        assert(excerpt.author.nonEmpty)
        assert(excerpt.work.nonEmpty)
        assert(excerpt.source.startsWith("https://www.gutenberg.org/ebooks/"))
    val app = Practice(Random(42))
    app.start(0)
    val g = Grid(100, 24)
    drawPractice(g, app, 0)
    val excerpt = shortLiterature(app.lesson)
    assert(g.rowText(2).contains(excerpt.author))
    assert(g.rowText(2).contains(excerpt.work))

@test("all longer passages are attributed literature and display author and book")
longAttribution()
    assertEq(longLiterature.length, 8)
    assertEq(longLiterature.length, longPassages.length)
    val app = Practice(Random(42))
    app.start(1)
    for i in 0 ..< longLiterature.length
        val excerpt = longLiterature(i)
        assertEq(excerpt.text, longPassages(i))
        assert(excerpt.text.charCount >= 550)
        assert(excerpt.author.nonEmpty)
        assert(excerpt.work.nonEmpty)
        assert(excerpt.source.startsWith("https://www.gutenberg.org/ebooks/"))
        app.lesson = i
        val g = Grid(100, 24)
        drawPractice(g, app, 0)
        assert(g.rowText(2).contains(excerpt.author))
        assert(g.rowText(2).contains(excerpt.work))
