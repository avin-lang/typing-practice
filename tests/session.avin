module tests

import dev.avinlang.typing.{Session, draw, passagePositions}
import dev.avinlang.tui.{Backspace, Char, Ctrl, Enter, Escape, Grid, KeyPress, Paste, Resize, Stop, Tab}

@test("the clock starts on the first character and freezes at completion")
clock()
    val s = Session("abcde")
    assertEq(s.elapsed(5000), 0)
    assertEq(s.wpm(5000), 0)
    s.typeChar('a', 1000)
    assertEq(s.elapsed(2000), 1000)
    for c in "bcde".chars
        s.typeChar(c, 13000)
    assert(s.done())
    assertEq(s.elapsed(99000), 12000)
    assertEq(s.wpm(99000), 5)
    assertEq(s.accuracy(), 100)
    s.typeChar('x', 100000)
    s.backspace()
    assertEq(s.attempts, 5)
    assertEq(s.typed.length, 5)

@test("correction repairs the text while accuracy retains mistaken attempts")
correction()
    val s = Session("ab")
    s.backspace()
    s.typeChar('x', 1000)
    assertEq(s.correct(), 0)
    assertEq(s.accuracy(), 0)
    s.backspace()
    s.typeChar('a', 2000)
    s.typeChar('b', 3000)
    assertEq(s.correct(), 2)
    assertEq(s.mistakes, 1)
    assertEq(s.attempts, 3)
    assertEq(s.accuracy(), 66)
    assertEq(s.wpm(4000), 12)

@test("mistakes can finish a passage and only correct positions contribute to speed")
errors()
    val s = Session("ab")
    s.typeChar('x', 0)
    s.typeChar('b', 12000)
    assert(s.done())
    assertEq(s.correct(), 1)
    assertEq(s.wpm(12000), 1)
    assertEq(s.accuracy(), 50)

@test("commands do not type, paste is ignored, and q is a normal character")
commands()
    val s = Session("quiz")
    assertEq(s.handle(Paste("quiz"), 100), 0)
    assertEq(s.handle(Resize(80, 24), 100), 0)
    assertEq(s.handle(KeyPress(Enter, 0), 100), 0)
    assertEq(s.handle(KeyPress(Char('r'), Ctrl), 100), 2)
    assertEq(s.handle(KeyPress(Tab, 0), 100), 3)
    assertEq(s.handle(KeyPress(Escape, 0), 100), 1)
    assertEq(s.handle(KeyPress(Char('c'), Ctrl), 100), 1)
    assertEq(s.handle(Stop(15), 100), 1)
    assertEq(s.attempts, 0)
    assertEq(s.started, None)
    s.handle(KeyPress(Char('q'), 0), 100)
    assertEq(s.typed.length, 1)
    s.handle(KeyPress(Backspace, 0), 200)
    assertEq(s.typed.length, 0)

@test("empty and zero-duration sessions have safe scores")
boundaries()
    val empty = Session("")
    assert(empty.done())
    assertEq(empty.wpm(0), 0)
    assertEq(empty.accuracy(), 100)
    assertEq(empty.handle(KeyPress(Enter, 0), 0), 3)
    val s = Session("a")
    s.typeChar('a', 0)
    assertEq(s.wpm(0), 0)
    assertEq(s.elapsed(-1), 0)

@test("views render at small sizes and scroll the cursor into view")
views()
    val s = Session("abcdefghijklmnopqrstuvwxyzabczabcdefghijklmnopqrstuvwxyzabczabcdefghijklmnopqrstuvwxyzabczabcdefghijklmnopqrstuvwxyzabcz")
    for (w, h) in [(0, 0), (1, 1), (39, 14), (40, 15), (80, 24), (120, 40)]
        val g = Grid(w, h)
        draw(g, s, 0, 0)
        if w >= 40 && h >= 15
            assert(g.rowText(1).contains("TYPE / practice"))
    for c in s.target
        s.typeChar(c, 1000)
    val g = Grid(40, 15)
    draw(g, s, 0, 2000)
    assert(g.rowText(12).contains("Complete!"))

@test("words wrap together and exact-width and oversized words remain accessible")
wordWrapping()
    val p = passagePositions("one three six".chars, 8)
    assertEq(p(4), (0, 1))
    assertEq(p(8), (4, 1))
    assertEq(p(10), (0, 2))
    val exact = passagePositions("abcdefgh ij".chars, 8)
    assertEq(exact(7), (7, 0))
    assertEq(exact(9), (0, 1))
    val longWord = passagePositions("abcdefghij".chars, 8)
    assertEq(longWord(8), (0, 1))
    assertEq(passagePositions([ ], 8), [(0, 0)])

@test("drawing wraps a word and scrolls to its highlighted typing position")
wrappedView()
    val s = Session("abcdefghijklmnopqrstuvwxyzabc hello next")
    val g = Grid(40, 15)
    draw(g, s, 0, 0)
    assert(g.rowText(7).contains("abcdefghijklmnopqrstuvwxyzabc"))
    assert(!g.rowText(7).contains("hello"))
    assert(g.rowText(8).contains("hello next"))
    for c in "abcdefghijklmnopqrstuvwxyzabc ".chars
        s.typeChar(c, 0)
    val narrow = Grid(40, 15)
    draw(narrow, s, 0, 0)
    assertEq(narrow(4, 8).text, "h")
    val wide = Grid(80, 15)
    draw(wide, s, 0, 0)
    assert(wide.rowText(7).contains("hello next"))
