module tests

// Typing, scoring and timing of one drill, with times given in milliseconds.
import dev.avinlang.typist.{Next, Pending, Right, Session, Wrong}

typeAll(s: Session, text: string, at: long)
    for c in text.chars
        s.typeChar(c, at)

@test("the clock starts on the first character and freezes at completion")
timing()
    val s = Session("abcde")
    assertEq(s.elapsed(5000), 0)
    assertEq(s.wpm(5000), 0)
    s.typeChar('a', 1000)
    assertEq(s.elapsed(2000), 1000)
    typeAll(s, "bcde", 13000)
    assert(s.done)
    assertEq(s.elapsed(99000), 12000)
    assertEq(s.wpm(99000), 5)
    assertEq(s.accuracy, 100)

@test("keys after completion type nothing and backspace cannot reopen the drill")
afterCompletion()
    val s = Session("ab")
    typeAll(s, "ab", 1000)
    assert(!s.typeChar('x', 2000))
    s.backspace()
    assertEq(s.keystrokes, 2)
    assertEq(s.cursor, 2)
    assertEq(s.finished, Some(long(1000)))

@test("backspace at the start does nothing and starts no clock")
backspaceAtStart()
    val s = Session("abc")
    s.backspace()
    assertEq(s.cursor, 0)
    assertEq(s.keystrokes, 0)
    assertEq(s.started, None)

@test("correction repairs the text while accuracy keeps the mistaken keystroke")
correction()
    val s = Session("ab")
    assert(s.typeChar('x', 1000))
    assertEq(s.correct, 0)
    assertEq(s.accuracy, 0)
    s.backspace()
    assert(!s.typeChar('a', 2000))
    assert(!s.typeChar('b', 3000))
    assertEq(s.correct, 2)
    assertEq(s.mistakes, 1)
    assertEq(s.keystrokes, 3)
    assertEq(s.accuracy, 66)
    assertEq(s.wpm(4000), 12)

@test("all correct: full accuracy and speed from every character")
allCorrect()
    val s = Session("the cat sat")
    typeAll(s, "the cat sat", 0)
    s.typeChar('t', 0)
    assert(s.done)
    assertEq(s.correct, 11)
    assertEq(s.mistakes, 0)
    assertEq(s.accuracy, 100)

@test("all wrong: the drill still completes, with no speed and no accuracy")
allWrong()
    val s = Session("abc")
    s.typeChar('x', 0)
    s.typeChar('y', 6000)
    s.typeChar('z', 12000)
    assert(s.done)
    assertEq(s.correct, 0)
    assertEq(s.mistakes, 3)
    assertEq(s.accuracy, 0)
    assertEq(s.wpm(12000), 0)
    assertEq([s.mark(0), s.mark(1), s.mark(2)], [Wrong, Wrong, Wrong])

@test("mistakes can finish a passage and only correct characters count towards speed")
errorsFinish()
    val s = Session("ab")
    s.typeChar('x', 0)
    s.typeChar('b', 12000)
    assert(s.done)
    assertEq(s.correct, 1)
    assertEq(s.wpm(12000), 1)
    assertEq(s.accuracy, 50)

@test("control characters type nothing")
controlCharacters()
    val s = Session("a")
    for c in ['\n', '\t', '\u{1b}', '\u{7f}', '\u{0}']
        assert(!s.typeChar(c, 0))
    assertEq(s.keystrokes, 0)
    assertEq(s.started, None)

@test("an empty passage is done from the start with safe scores")
emptyPassage()
    val s = Session("")
    assert(s.done)
    assertEq(s.wpm(0), 0)
    assertEq(s.accuracy, 100)
    assertEq(s.progress, 1.0)
    assert(!s.typeChar('a', 0))
    assertEq(s.elapsed(-1), 0)

@test("a drill finished in no time has no speed rather than an infinite one")
zeroDuration()
    val s = Session("a")
    s.typeChar('a', 0)
    assertEq(s.wpm(0), 0)
    assertEq(s.elapsed(5000), 0)

@test("Unicode passages are typed character by character")
unicodePassage()
    val s = Session("café 東京 ü")
    assertEq(s.target.length, 9)
    typeAll(s, "cafe", 0)
    assertEq(s.mark(3), Wrong)
    s.backspace()
    typeAll(s, "é 東京 ", 0)
    assertEq(s.mark(8), Next)
    s.typeChar('ü', 6000)
    assert(s.done)
    assertEq(s.correct, 9)
    assertEq(s.mistakes, 1)

@test("each character is marked right, wrong, next or pending, and progress follows the cursor")
marks()
    val s = Session("abcd")
    s.typeChar('a', 0)
    s.typeChar('x', 0)
    assertEq([s.mark(0), s.mark(1), s.mark(2), s.mark(3)], [Right, Wrong, Next, Pending])
    assertEq(s.progress, 0.5)
