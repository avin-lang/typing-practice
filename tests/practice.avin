module tests

import avin.random.Random
import dev.avinlang.typing.{Mistakes, Practice, Session, drawPractice, longPassages, passages, trickyWords, wordDrill}
import dev.avinlang.tui.{Backspace, Char, Ctrl, Down, Enter, Escape, Grid, KeyPress, Paste, Stop, Tab, Up}

@test("menu keys choose modes, return to menu, and quit")
menuNavigation()
    val app = Practice(Random(42))
    assert(app.menu)
    app.handle(KeyPress(Up, 0), 0)
    assertEq(app.selected, 3)
    app.handle(KeyPress(Enter, 0), 0)
    assert(app.menu)
    app.handle(KeyPress(Down, 0), 0)
    assertEq(app.selected, 0)
    app.handle(KeyPress(Enter, 0), 0)
    assert(!app.menu)
    assert(passages.contains(app.session.passage))
    assert(!app.handle(KeyPress(Escape, 0), 0))
    assert(app.menu)
    app.handle(KeyPress(Char('2'), 0), 0)
    assertEq(app.mode, 1)
    assert(longPassages.contains(app.session.passage))
    assert(app.handle(KeyPress(Char('c'), Ctrl), 0))
    assert(app.handle(Stop(15), 0))
    app.handle(KeyPress(Escape, 0), 0)
    assert(app.handle(KeyPress(Escape, 0), 0))

@test("short and long selections avoid repeats and retries keep the same passage")
modeSelection()
    val app = Practice(Random(1))
    for mode in [0, 1]
        app.start(mode)
        for _ in 0 ..< 30
            val previous = app.session.passage
            app.handle(KeyPress(Char('r'), Ctrl), 0)
            assertEq(app.session.passage, previous)
            assertEq(app.session.attempts, 0)
            app.handle(KeyPress(Tab, 0), 0)
            assert(app.session.passage != previous)
    for passage in longPassages
        assert(passage.charCount() >= 550)
    app.start(2)
    assertEq(app.session.passage.split(" ").length(), 24)
    for word in app.session.passage.split(" ")
        assert(trickyWords.contains(word))

@test("corrected word mistakes feed personal practice and separator errors are ignored")
personalPractice()
    val app = Practice(Random(7))
    app.start(0)
    app.session = Session("hello world")
    app.handle(Paste("wrong"), 0)
    assert(app.mistakes.words.isEmpty())
    app.handle(KeyPress(Char('x'), 0), 0)
    app.handle(KeyPress(Backspace, 0), 1)
    for c in "hello".chars()
        app.handle(KeyPress(Char(c), 0), 2)
    app.handle(KeyPress(Char('x'), 0), 3)
    assertEq(app.mistakes.words.toVector(), ["hello"])
    app.handle(KeyPress(Escape, 0), 4)
    app.start(3)
    assert(!app.menu)
    assertEq(app.session.passage, "hello")
    app.handle(KeyPress(Char('r'), Ctrl), 5)
    assertEq(app.mistakes.words.length(), 1)

@test("personal words strip punctuation and repeated mistakes remain unique")
wordExtraction()
    val m = Mistakes()
    val target = "don't panic!".chars()
    m.record(target, 3)
    m.record(target, 6)
    m.record(target, 11)
    m.record(target, -1)
    m.record(target, 12)
    assertEq(m.words.toVector(), ["don't", "panic"])
    assertEq(wordDrill(Random(1), []), "")
    val words = m.drill(Random(42)).split(" ")
    assert(words.contains("don't"))
    assert(words.contains("panic"))
    assertEq(words.length(), 2)

@test("menu explains empty personal practice and all screens render at supported sizes")
menuView()
    val app = Practice(Random(42))
    app.selected = 3
    val menu = Grid(80, 24)
    drawPractice(menu, app, 0)
    assert(menu.rowText(6).contains("Longer passages"))
    assert(menu.rowText(10).contains("Type a drill first"))
    for mode in [0, 1, 2]
        app.start(mode)
        for (w, h) in [(0, 0), (20, 8), (40, 15), (80, 24)]
            drawPractice(Grid(w, h), app, 0)
        for c in app.session.target.take(app.session.target.length() - 1)
            app.handle(KeyPress(Char(c), 0), 100)
        drawPractice(Grid(40, 15), app, 200)
        val end = Grid(80, 24)
        drawPractice(end, app, 200)
        assert(end.rowText(4).contains("characters"))
        app.menu = true
        drawPractice(Grid(20, 8), app, 0)

@test("saved words preserve case and remove digits symbols and non-word tokens")
normalizedMistakes()
    val m = Mistakes()
    for text in ["Hello!", "hello", "HELLO,", "[hello]", "he11llo", "--", "123", "$42.50", "...", "_Hello_", "café!", "CAFÉ"]
        m.record(text.chars(), 0)
    assertEq(m.words.toVector(), ["Hello", "café"])
    m.record("  ".chars(), 1)
    assertEq(m.words.length(), 2)

@test("personal drills contain unique entries and cap large collections at 24")
uniquePersonalDrills()
    val m = Mistakes()
    assertEq(m.drill(Random(1)), "")
    for word in trickyWords
        m.record(word.chars(), 0)
    for seed in [1, 2, 42]
        val words = m.drill(Random(long(seed))).split(" ")
        assertEq(words.length(), 24)
        for i in 0 ..< words.length()
            assert(m.words.contains(words(i)))
            for j in i + 1 ..< words.length()
                assert(words(i) != words(j))

@test("mistakes at spaces and whitespace do not save the preceding or following word")
spaceMistakes()
    val m = Mistakes()
    val text = " hello  world ".chars()
    for i in [0, 6, 7, 13]
        m.record(text, i)
    m.record("hello\tworld".chars(), 5)
    m.record("hello\nworld".chars(), 5)
    assert(m.words.isEmpty())
    val app = Practice(Random(42))
    app.start(0)
    app.session = Session("a b")
    app.handle(KeyPress(Char('a'), 0), 0)
    app.handle(KeyPress(Char('x'), 0), 1)
    assertEq(app.session.mistakes, 1)
    assert(app.mistakes.words.isEmpty())
    app.handle(KeyPress(Escape, 0), 2)
    app.start(3)
    assert(app.menu)

@test("contractions keep internal apostrophes and discard surrounding quotes")
contractions()
    val m = Mistakes()
    for text in ["I'm", "I’m", "'I'm'", "\"I'm!\"", "don't,", "DON’T", "‘don't’", "they're.", "'hello'", "rock'n'roll"]
        m.record(text.chars(), 1)
    assertEq(m.words.toVector(), ["I'm", "don't", "they're", "hello", "rock'n'roll"])
    val words = m.drill(Random(42)).split(" ")
    assert(words.contains("I'm"))
    assert(words.contains("don't"))

@test("first-person pronouns and contractions retain proper capitalization without duplicates")
firstPerson()
    val m = Mistakes()
    for text in ["i", "I", "i'm", "I'm", "I’M", "i'd", "I'd", "i'll", "I'll", "i've", "I've"]
        m.record(text.chars(), 0)
    assertEq(m.words.toVector(), ["I", "I'm", "I'd", "I'll", "I've"])
    val words = m.drill(Random(42)).split(" ")
    assertEq(words.length(), 5)
    assert(words.contains("I'm"))

@test("proper nouns retain source capitalization and case variants do not duplicate them")
capitalizedWords()
    val m = Mistakes()
    for text in ["February,", "Wednesday.", "London!", "Alice", "Elizabeth", "February", "FEBRUARY", "february", "wednesday", "ALICE"]
        m.record(text.chars(), 1)
    assertEq(m.words.toVector(), ["February", "Wednesday", "London", "Alice", "Elizabeth"])
    val words = m.drill(Random(42)).split(" ")
    assertEq(words.length(), 5)
    assert(words.contains("February"))
    assert(words.contains("Wednesday"))
    val app = Practice(Random(42))
    app.start(0)
    app.session = Session("February")
    app.handle(KeyPress(Char('x'), 0), 0)
    app.start(3)
    assertEq(app.session.passage, "February")
