module tests

// The program driven by events as the terminal loop drives it: the menu, the drill keys, the results
// box and the mistakes drill.
import avin.random.Random
import dev.avinlang.typist.{LongPassages, Mode, MyMistakes, Practice, Quit, Session, ShortPassages, Stay, TrickyWords,
                            longExcerpts, shortExcerpts, trickyWords}
import dev.avinlang.tui.{Alt, Backspace, Char, Ctrl, Down, Enter, Escape, Event, KeyPress, Paste, Resize, Stop, Tab, Up}

key(c: char) -> Event = KeyPress(Char(c), 0)
ctrl(c: char) -> Event = KeyPress(Char(c), Ctrl)

typeText(app: Practice, text: string, at: long)
    for c in text.chars
        assertEq(app.handle(key(c), at), Stay)

// A drill of `text` in mode `m`, as though it had been chosen.
drilling(m: Mode, text: string) -> Practice
    val app = Practice(Random(7))
    app.start(m)
    app.session = Session(text)
    app

@test("the menu moves with the arrows, stops at its ends, and starts the selected mode")
menu()
    val app = Practice(Random(42))
    assert(app.choosing)
    app.handle(KeyPress(Up, 0), 0)
    assertEq(app.menu.selected, 0)
    app.handle(KeyPress(Down, 0), 0)
    app.handle(KeyPress(Enter, 0), 0)
    assert(!app.choosing)
    assertEq(app.mode, LongPassages)
    assert(longExcerpts.exists(e -> e.text == app.session.passage))
    assertEq(app.handle(KeyPress(Escape, 0), 0), Stay)
    assert(app.choosing)
    assertEq(app.menu.selected, 1)
    app.handle(key('3'), 0)
    assertEq(app.mode, TrickyWords)
    assert(app.session.passage.split(" ").forall(w -> trickyWords.contains(w)))

@test("the mistakes drill waits for a mistake, and digits outside the menu are typed")
mistakesNeedAMistake()
    val app = Practice(Random(42))
    app.handle(key('4'), 0)
    assert(app.choosing)
    assert(!app.available(MyMistakes))
    for _ in 0 ..< 5
        app.handle(KeyPress(Down, 0), 0)
    assertEq(app.menu.selected, 3)
    app.handle(KeyPress(Enter, 0), 0)
    assert(app.choosing)

@test("Ctrl-C and a signal quit from the menu, a drill and the results; Esc quits only from the menu")
quitting()
    for e in [ctrl('c'), Stop(15), KeyPress(Char('c'), Ctrl | Alt)]
        assertEq(Practice(Random(1)).handle(e, 0), Quit)
        assertEq(drilling(ShortPassages, "ab").handle(e, 0), Quit)
        val done = drilling(ShortPassages, "a")
        done.handle(key('a'), 0)
        assertEq(done.handle(e, 0), Quit)
    assertEq(Practice(Random(1)).handle(KeyPress(Escape, 0), 0), Quit)
    assertEq(drilling(ShortPassages, "ab").handle(KeyPress(Escape, 0), 0), Stay)

@test("Ctrl-R retries the same passage with a fresh score, and Tab moves to another")
retryAndNext()
    val app = Practice(Random(1))
    for m in [ShortPassages, LongPassages]
        app.start(m)
        for _ in 0 ..< 30
            val previous = app.session.passage
            app.handle(key('x'), 0)
            app.handle(ctrl('r'), 0)
            assertEq(app.session.passage, previous)
            assertEq(app.session.keystrokes, 0)
            app.handle(KeyPress(Tab, 0), 0)
            assert(app.session.passage != previous)

@test("the attribution follows the passage being typed, and word drills have none")
attribution()
    val app = Practice(Random(3))
    app.start(ShortPassages)
    assertEq(app.excerpt.map(e -> e.text), Some(app.session.passage))
    app.start(LongPassages)
    assertEq(app.excerpt.map(e -> e.text), Some(app.session.passage))
    app.start(TrickyWords)
    assertEq(app.excerpt, None)

@test("paste, resize, Enter mid-drill and Alt keys type nothing; q is an ordinary character")
ignoredEvents()
    val app = drilling(ShortPassages, "quiz")
    for e in [Paste("quiz"), Resize(80, 24), KeyPress(Enter, 0), KeyPress(Char('q'), Alt), KeyPress(Up, 0)]
        assertEq(app.handle(e, 100), Stay)
    assertEq(app.session.keystrokes, 0)
    app.handle(key('q'), 100)
    assertEq(app.session.cursor, 1)
    app.handle(KeyPress(Backspace, 0), 200)
    assertEq(app.session.cursor, 0)

@test("finishing a drill opens the results, which take keys until answered")
results()
    val app = drilling(TrickyWords, "ab")
    typeText(app, "ab", 1000)
    assertEq(app.modals.length(), 1)
    app.handle(key('x'), 2000)
    app.handle(KeyPress(Backspace, 0), 2000)
    assertEq(app.session.cursor, 2)
    assertEq(app.modals.length(), 1)
    app.handle(key('r'), 3000)
    assert(app.modals.isEmpty())
    assertEq(app.session.passage, "ab")
    assertEq(app.session.cursor, 0)

@test("the results' Enter draws a new drill, Esc goes to the menu, q quits")
resultsKeys()
    val next = drilling(TrickyWords, "ab")
    typeText(next, "ab", 0)
    next.handle(KeyPress(Enter, 0), 0)
    assert(next.modals.isEmpty())
    assertEq(next.session.passage.split(" ").length, 24)
    val back = drilling(LongPassages, "ab")
    typeText(back, "ab", 0)
    back.handle(KeyPress(Escape, 0), 0)
    assert(back.modals.isEmpty() && back.choosing)
    assertEq(back.menu.selected, 1)
    val leave = drilling(TrickyWords, "ab")
    typeText(leave, "ab", 0)
    assertEq(leave.handle(key('q'), 0), Quit)

@test("words mistyped, even when corrected, become the mistakes drill; mistakes at spaces do not")
mistakesDrill()
    val app = drilling(ShortPassages, "hello world a b")
    app.handle(Paste("wrong"), 0)
    assert(app.mistakes.words.isEmpty)
    app.handle(key('x'), 0)
    app.handle(KeyPress(Backspace, 0), 1)
    typeText(app, "hello", 2)
    app.handle(key('x'), 3)
    typeText(app, "world", 4)
    app.handle(key(' '), 5)
    app.handle(key('a'), 5)
    app.handle(key('x'), 6)
    assertEq(app.mistakes.words.toVector, ["hello"])
    app.handle(KeyPress(Escape, 0), 7)
    assert(app.available(MyMistakes))
    app.handle(key('4'), 8)
    assert(!app.choosing)
    assertEq(app.mode, MyMistakes)
    assertEq(app.session.passage, "hello")
    app.handle(ctrl('r'), 9)
    assertEq(app.session.passage, "hello")
