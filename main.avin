import avin.time
import avin.random.Random
import dev.avinlang.typing.{Practice, drawPractice}
import dev.avinlang.tui.{Options, Terminal}

main() -> int = Terminal.use(Options(), run) match
    Ok(()) -> 0
    Err(e) ->
        eprintln(s"typing-practice: ${e.message}")
        1

run(term: Terminal)
    val app = Practice(Random())
    loop
        val g = term.frame()
        drawPractice(g, app, time.monotonic().toMillis)
        term.present(g)
        term.poll(time.millis(50)) match
            Some(event) ->
                if app.handle(event, time.monotonic().toMillis) then return
            None -> ()
